---
import releases from '../lib/downloads.json';
const { lang = 'es' } = Astro.props;
const es = lang === 'es';
const labels: Record<string, string> = {
  'windows-x64': 'Windows · x64',
  'macos-arm64': 'Mac · Apple Silicon',
  'macos-x86_64': 'Mac · Intel'
};
const descriptions: Record<string, string> = es ? {
  live: 'Marcador, OCR, gráficos y control de la retransmisión.',
  manager: 'Competiciones, equipos, jugadores e identidad visual.'
} : {
  live: 'Scoreboard, OCR, graphics and broadcast control.',
  manager: 'Competitions, teams, players and visual identity.'
};
const size = (bytes: number) => `${Math.round(bytes / 1_000_000)} MB`;
---
<section class="page-hero download-hero" data-downloads data-lang={lang}>
  <div class="shell">
    <span class="account-kicker">SECRETARIATPRO · {es ? 'DESCARGAS' : 'DOWNLOADS'}</span>
    <h1>{es ? 'Todo listo.' : 'Ready to go.'}<br /><span class="kicker">{es ? 'Empieza aquí.' : 'Start here.'}</span></h1>
    <p class="lead">{es ? 'Elige Live para la retransmisión y Manager para preparar la competición. Descarga el instalador y sigue trabajando con tu cuenta.' : 'Choose Live for broadcasting and Manager to prepare your competition. Download the installer and continue with your account.'}</p>
    <p class="muted download-detection" data-detection-status aria-live="polite">{es ? 'Versiones para Windows x64 y macOS. Elige tu equipo en las opciones de descarga.' : 'Versions for Windows x64 and macOS. Choose your computer in the download options.'}</p>
    <div class="grid-2 download-grid">
      {['live', 'manager'].map((product) => (
        <article class="card download-card" id={product} data-download-card>
          <span class="account-kicker">{product === 'live' ? (es ? 'EN DIRECTO' : 'LIVE PRODUCTION') : (es ? 'COMPETICIÓN' : 'COMPETITION')}</span>
          <h2>SecretariatPro<br /><span class="kicker">{product === 'live' ? 'Live' : 'Manager'}</span></h2>
          <p class="muted">{descriptions[product]}</p>
          <div data-download-picker hidden>
            <label class="download-label" for={`platform-${product}`}>{es ? 'Tu equipo' : 'Your computer'}</label>
            <select class="download-select" id={`platform-${product}`}>
              <option value="">{es ? 'Selecciona una versión' : 'Choose a version'}</option>
              {Object.entries(labels).map(([platform, label]) => <option value={platform}>{label}</option>)}
            </select>
            <a class="button download-primary" data-download-main hidden>{es ? 'Descargar' : 'Download'}</a>
            <p class="muted download-meta" data-download-meta></p>
          </div>
          <div class="download-options" aria-label={es ? 'Todos los instaladores' : 'All installers'}>
            {releases.filter((release) => release.product === product).map((release) => (
              <a href={release.path} data-platform={release.platform} data-meta={`Beta ${release.version.split('.').at(-1)} · ${size(release.bytes)} · ${release.file.endsWith('.exe') ? '.exe' : '.dmg'}`}>
                <span><strong>{labels[release.platform]}</strong><small>Beta {release.version.split('.').at(-1)} · {size(release.bytes)}</small></span>
                <span class="download-arrow" aria-hidden="true">↓</span>
                <span class="sr-only">{es ? 'Descargar' : 'Download'} SecretariatPro {product === 'live' ? 'Live' : 'Manager'}</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
    <p class="muted download-footnote">{es ? 'La descarga empieza desde esta página. No necesitas visitar otra web. Los números de beta pueden variar entre Windows y Mac.' : 'Your download starts from this page. No need to visit another website. Beta numbers may differ between Windows and Mac.'}</p>
  </div>
</section>
<script>
  import '../scripts/downloads';
</script>
<style>
  .download-hero{padding-bottom:90px}
  .download-detection{max-width:800px;margin:30px 0}
  .download-grid{align-items:stretch;gap:26px;margin-top:40px}
  .download-card{padding:36px;scroll-margin-top:100px;min-width:0}
  .download-card h2{font-size:clamp(2rem,3.7vw,3.4rem);line-height:1.08;overflow-wrap:anywhere}
  .download-card>p{min-height:50px}
  .download-label{display:block;font-size:.85rem;font-weight:750;margin:26px 0 8px}
  .download-select{width:100%;padding:14px;color:var(--white);background:var(--deep2);border:1px solid var(--aline);border-radius:12px}
  .download-primary{width:100%;margin-top:16px;text-align:center;padding-block:14px;line-height:1.4}
  .download-meta{font-size:.85rem;margin:10px 0}
  .download-options{margin-top:26px;border-top:1px solid var(--line)}
  .download-options a{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:19px 4px;border-bottom:1px solid var(--line)}
  .download-options a:hover{color:var(--aqua)}
  .download-options strong{font-size:.95rem}
  .download-options small{display:block;font-size:.8rem;color:var(--muted);margin-top:4px}
  .download-arrow{color:var(--aqua);font-size:1.6rem}
  .download-footnote{font-size:.9rem;max-width:800px;margin-top:26px}
  [hidden]{display:none!important}
  @media(max-width:700px){.download-grid{grid-template-columns:1fr}.download-card{padding:26px}}
  a:focus-visible,select:focus-visible{outline:2px solid var(--aqua);outline-offset:5px}
</style>
